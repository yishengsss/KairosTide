# MiMo API key used by the API server only. Leave blank to disable MiMo.
MIMO_API_KEY=

# Optional alternative: read the key from a separate local file instead.
# MIMO_API_KEY_FILE=/absolute/path/to/mimo-api-key.txt

# Optional local SQLite database path (defaults to var/kairos-dev.sqlite3).
# KAIROS_DB_PATH=var/kairos-dev.sqlite3
